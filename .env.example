# === WP Audit Tool Configuration ===

# Discord Webhook URL (required)
# Créer un webhook : Paramètres du canal → Intégrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# WPScan API Token (optional, but recommended for vulnerability data)
# Obtenir un token gratuit : https://wpscan.com/profile
WPSCAN_API_TOKEN=

# Path to WPScan binary (default: wpscan)
WPSCAN_PATH=wpscan

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
